{
  "name": "bank-radar-ir",
  "version": "2.0.0",
  "private": true,
  "description": "رادار محصولات بانکی ایران — پایش، مقایسه و رتبه‌بندی محصولات منابعی، اعتباری، تسهیلاتی و امتیازی بانک‌ها با خط لوله داده خودکار",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "collect": "node tools/collect.mjs",
    "collect:dry": "node tools/collect.mjs --dry-run",
    "collect:offline": "node tools/collect.mjs --offline",
    "bundle": "node tools/build-bundle.mjs",
    "build": "npm run collect:offline && npm run validate",
    "validate": "node scripts/validate-data.mjs",
    "test": "node scripts/validate-data.mjs && node --test \"tests/*.test.mjs\"",
    "serve": "node tools/serve.mjs"
  },
  "keywords": [
    "iran",
    "banking",
    "data",
    "comparison",
    "open-data"
  ],
  "license": "MIT"
}
